# Minimal sandbox image for pi-container-sandbox
#
# Goals:
#   - small, predictable surface area
#   - tools the agent typically needs to read/edit/grep/build code
#   - non-root user `pi` (uid/gid 1000) — agent never runs as root
#   - no SSH, no sudo, no setuid binaries beyond what the base image ships
#   - GitHub-downloaded binaries are SHA256-verified at build time
#
# Architecture support:
#   Build automatically detects host arch (aarch64 or x86_64) and sources
#   the matching hashes/<arch>.env file for download URLs and SHA256s.
#
# Built with:
#   podman build -t pi-container-sandbox:latest -f containers/Containerfile containers
FROM registry.fedoraproject.org/fedora-minimal:44

# ── Base system packages ────────────────────────────────────────────
# Fedora 44 ships recent versions of most modern CLI tools, so we
# install them directly via dnf5 instead of downloading from GitHub.
RUN dnf5 install -y --setopt=install_weak_deps=False \
        bash \
        bat \
        ca-certificates \
        chromium-headless \
        coreutils \
        curl \
        eza \
        fd-find \
        file \
        findutils \
        gcc \
        go \
        git \
        gpgme \
        jq \
        krb5-devel \
        less \
        libatomic \
        libvirt-devel \
        make \
        nodejs \
        pkg-config \
        python3 \
        python3-pip \
        ripgrep \
        sed \
        shadow-utils \
        tar \
        tini \
        unzip \
        xz \
        yq \
 && dnf5 clean all \
 && node --version \
 && python3 --version

# ── Arch-specific hashes + helper ───────────────────────────────────
# Each hashes/<arch>.env file defines URLs, SHA256s, and binary paths
# for ast-grep, uv, and bun. The dl-verify helper downloads a file
# and fails the build if the hash doesn't match.
COPY hashes/ /tmp/hashes/

RUN printf '#!/bin/sh\nset -e\nURL="$1" HASH="$2" OUT="$3"\nFILE=$(mktemp)\ncurl -fsSL "$URL" -o "$FILE"\necho "$HASH  $FILE" | sha256sum -c\nmv "$FILE" "$OUT"\nchmod +x "$OUT"\n' > /usr/local/bin/dl-verify \
 && chmod +x /usr/local/bin/dl-verify

# ── ast-grep — structural code search & replace ────────────────────
RUN . /tmp/hashes/$(uname -m).env \
 && dl-verify "$AST_GREP_URL" "$AST_GREP_SHA256" /tmp/ast-grep.zip \
 && unzip -o /tmp/ast-grep.zip -d /tmp/ast-grep-out \
 && if [ -f /tmp/ast-grep-out/"$AST_GREP_BIN" ]; then \
      mv /tmp/ast-grep-out/"$AST_GREP_BIN" /usr/local/bin/ast-grep; \
    elif [ -f /tmp/ast-grep-out/sg ]; then \
      mv /tmp/ast-grep-out/sg /usr/local/bin/ast-grep; \
    else \
      echo "ERROR: ast-grep binary not found in zip" >&2; exit 1; \
    fi \
 && chmod +x /usr/local/bin/ast-grep \
 && rm -rf /tmp/ast-grep.zip /tmp/ast-grep-out

# ── uv — fast Python package manager ───────────────────────────────
RUN . /tmp/hashes/$(uname -m).env \
 && dl-verify "$UV_URL" "$UV_SHA256" /tmp/uv.tar.gz \
 && tar xzf /tmp/uv.tar.gz -C /tmp \
 && mv /tmp/"$UV_DIR"/uv /usr/local/bin/uv \
 && mv /tmp/"$UV_DIR"/uvx /usr/local/bin/uvx \
 && rm -rf /tmp/uv.tar.gz /tmp/"$UV_DIR"

# ── bun — JavaScript runtime ───────────────────────────────────────
RUN . /tmp/hashes/$(uname -m).env \
 && dl-verify "$BUN_URL" "$BUN_SHA256" /tmp/bun.zip \
 && unzip -o /tmp/bun.zip -d /tmp/bun-out \
 && mv /tmp/bun-out/"$BUN_DIR"/bun /usr/local/bin/bun \
 && ln -sf /usr/local/bin/bun /usr/local/bin/bunx \
 && chmod +x /usr/local/bin/bun \
 && rm -rf /tmp/bun.zip /tmp/bun-out \
 && bun --version

# Clean up build artifacts — reduces attack surface
RUN rm -rf /tmp/hashes /usr/local/bin/dl-verify

# ── Wrapper scripts: modern tools override legacy commands ──────────
# The sandbox agent runs commands via `sh -c` which doesn't support
# aliases. Wrapper scripts in /usr/local/bin work in ALL shells.
# Original binaries remain at /usr/bin for scripts needing POSIX behavior.

# cat → bat (plain output, no paging)
RUN printf '#!/bin/sh\nexec bat --paging=never --style=plain "$@"\n' > /usr/local/bin/cat \
 && chmod +x /usr/local/bin/cat

# ls → eza
RUN printf '#!/bin/sh\nexec eza --icons "$@"\n' > /usr/local/bin/ls \
 && chmod +x /usr/local/bin/ls

# pip → uv pip
RUN printf '#!/bin/sh\nexec uv pip "$@"\n' > /usr/local/bin/pip \
 && printf '#!/bin/sh\nexec uv pip "$@"\n' > /usr/local/bin/pip3 \
 && chmod +x /usr/local/bin/pip /usr/local/bin/pip3

# ── Bash aliases (for interactive use only — `!` commands) ──────────
# NOTE: Heredocs don't work reliably in Containerfiles (podman interprets
# lines like `alias` as instructions). Use printf instead.
RUN printf '\n# Modern tool aliases for pi-container-sandbox\nalias ll="eza --icons -l --git"\nalias la="eza --icons -la --git"\nalias lt="eza --icons --tree --level=3"\n' >> /etc/bashrc

RUN printf '# Modern tool aliases for pi-container-sandbox (login shells)\nalias ll="eza --icons -l --git"\nalias la="eza --icons -la --git"\nalias lt="eza --icons --tree --level=3"\n' > /etc/profile.d/sandbox-aliases.sh

# ── Non-root user ───────────────────────────────────────────────────
# uid 1000 keeps file ownership predictable when the host cwd
# is bind-mounted into /workspace.
RUN groupadd -g 1000 pi \
 && useradd  -m -u 1000 -g 1000 -s /bin/bash pi \
 && mkdir -p /workspace \
 && chown -R pi:pi /workspace /home/pi

USER pi
WORKDIR /workspace

# tini reaps zombies so long-running agent shells stay tidy
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
