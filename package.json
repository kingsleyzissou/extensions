{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@earendil-works/pi-coding-agent": "0.78.1",
    "@types/bun": "1.3.14",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "globals": "15.14.0",
    "prettier": "3.8.1",
    "typescript-eslint": "8.58.0"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  }
}
